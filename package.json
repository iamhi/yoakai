{
  "name": "yoakai",
  "version": "1.0.0",
  "description": "Zero-dependency CLI + plugin to run AI agents (Google Antigravity, GitHub Copilot CLI, Claude Code) headlessly with relative prompt files, persistent model/effort configurations, and auto-approved permissions.",
  "bin": {
    "yoakai": "./bin/yoakai.js"
  },
  "type": "module",
  "files": [
    "bin",
    "skills",
    "agents",
    "commands",
    "plugin.json",
    "com.github.copilot",
    ".claude-plugin",
    ".agents",
    "readme.md"
  ],
  "scripts": {
    "test": "node --test test/yoakai.test.js"
  },
  "keywords": [
    "antigravity",
    "agy",
    "copilot",
    "copilot-cli",
    "copilot-plugin",
    "claude-plugin",
    "headless",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  }
}
